# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/halqil_db"

# JWT Secrets (Must be changed in production!)
JWT_SECRET=super-secret-key-change-me-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-me-in-production

# File Uploads (Local fallback or Cloudinary)
UPLOAD_DIR=../uploads

# Cloudinary (Production File Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Setup (For first time seed)
ADMIN_EMAIL=admin@halqil.uz
ADMIN_PASSWORD=Admin1234!
